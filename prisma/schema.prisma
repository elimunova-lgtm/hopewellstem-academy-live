generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model NewsPost {
  id        String   @id @default(cuid())
  title     String
  excerpt   String
  image     String
  dateLabel String
  slug      String?  @unique
  content   String   @default("")
  category  String   @default("News")
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventPost {
  id          String    @id @default(cuid())
  title       String
  description String
  dateLabel   String
  time        String
  location    String
  image       String    @default("")
  published   Boolean   @default(true)
  sortOrder   Int       @default(0)
  startsAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model HomePopup {
  id          String    @id @default(cuid())
  title       String
  message     String
  image       String?
  buttonLabel String?
  buttonHref  String?
  published   Boolean   @default(true)
  sortOrder   Int       @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Flyer {
  id        String   @id @default(cuid())
  title     String
  image     String
  caption   String   @default("")
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inquiry {
  id         String   @id @default(cuid())
  parentName String
  phone      String
  email      String?
  childName  String?
  childLevel String?
  message    String   @default("")
  status     String   @default("new")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
