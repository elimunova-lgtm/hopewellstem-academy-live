OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Neon PostgreSQL (pooled URL for app runtime)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Direct URL for Prisma migrations (remove -pooler from hostname)
DIRECT_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# CMS admin login (used by prisma db seed)
ADMIN_EMAIL=officeathopewell@gmail.com
ADMIN_PASSWORD=change-this-password

# Random secret for admin session cookies (32+ characters)
AUTH_SECRET=replace-with-a-long-random-string

# Cloudinary (image hosting)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
